{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.spatie.be"
        },
        {
            "type": "composer",
            "url": "https://wire-elements-pro.composer.sh"
        },
        {
            "type": "vcs",
            "url": "https://github.com/amshehzad/laravel-form-components"
        },
        {
            "type": "vcs",
            "url": "https://github.com/amshehzad/laravel-livewire-tables"
        },
        {
            "type": "vcs",
            "url": "https://github.com/amshehzad/laravel-translatable"
        }
    ],
    "require": {
        "php": "^8.1",
        "barryvdh/laravel-dompdf": "^2.0",
        "beyondcode/laravel-websockets": "^1.13",
        "christophrumpel/missing-livewire-assertions": "^2.3",
        "cknow/laravel-money": "^7.0",
        "doctrine/dbal": "^3.6",
        "guzzlehttp/guzzle": "^7.0.1",
        "joedixon/laravel-translation": "^1.1",
        "kirschbaum-development/eloquent-power-joins": "^3.0",
        "laravel/framework": "^10.0",
        "laravel/socialite": "^5.5",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.2",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^3.0",
        "opcodesio/log-viewer": "^3.0",
        "pelmered/fake-car": "^1.7",
        "protonemedia/laravel-form-components": "dev-custom",
        "pusher/pusher-php-server": "^7.2",
        "rap2hpoutre/laravel-log-viewer": "^2.2",
        "rappasoft/laravel-livewire-tables": "dev-customized",
        "socialiteproviders/microsoft-azure": "^5.1",
        "spatie/laravel-activitylog": "^4.5",
        "spatie/laravel-collection-macros": "^7.11",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-medialibrary-pro": "^4.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-schemaless-attributes": "^2.3",
        "spatie/laravel-settings": "^3.2",
        "spatie/laravel-translatable": "dev-custom",
        "staudenmeir/belongs-to-through": "^2.5",
        "staudenmeir/eloquent-json-relations": "^1.7",
        "staudenmeir/laravel-cte": "^1.6",
        "staudenmeir/laravel-migration-views": "^1.6",
        "wire-elements/pro": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "brianium/paratest": "^7.1",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^7.0",
        "pestphp/pest": "^2.9",
        "pestphp/pest-plugin-laravel": "^2.0",
        "pestphp/pest-plugin-livewire": "^2.1",
        "pestphp/pest-plugin-type-coverage": "^2.8",
        "phpunit/phpunit": "^10.0",
        "plannr/laravel-fast-refresh-database": "^1.1",
        "spatie/laravel-ignition": "^2.0",
        "spatie/pest-plugin-test-time": "^2.0",
        "worksome/request-factories": "^3.0"
    },
    "autoload": {
        "files": [
            "app/Helpers/general.php",
            "app/Helpers/assets.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
