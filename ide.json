            "condition": [
                {
                    "place": "parameter",
                    "methodNames": ["setPreference", "getPreference"],
                    "classFqn": ["App\\Traits\\HasPreferences"]
                }
            ]
        },
        {
            "complete": "configKey",
            "options": {
                "prefix": "permissions"
            },
            "condition": [
                {
                    "place": "parameter",
                    "methodNames": ["givePermissionTo"],
                    "classFqn": ["\\Spatie\\Permission\\Traits\\HasPermissions"]
                }
            ]
        }
    ]
